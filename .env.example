# ⚡ FRONTEND WEB APPLICATION ENVIRONMENT EXAMPLE (.env.example)

# ─── API Base URL ──────────────────────────────────────────────
# In local development (with Vite proxy), leave empty or set to /api
# In production deployment (Vercel/Netlify), set to your live backend service URL (e.g. https://your-backend.onrender.com/api)
VITE_API_URL=

# ─── Stripe Publishable Key ─────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# ─── Sentry Error Monitoring (Frontend) ────────────────────────
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxx.ingest.us.sentry.io/xxxxxx
