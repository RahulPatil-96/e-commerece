# ============================================================================
# ARIHANT E-COMMERCE SERVER — ENVIRONMENT CONFIGURATION
# ============================================================================
# CRITICAL: Server will not start without the variables marked [REQUIRED]
# Copy this file to server/.env and fill in your actual values
# ============================================================================

# ─── DATABASE CONNECTION [REQUIRED] ────────────────────────────────────────
# PostgreSQL connection string (local dev or cloud-hosted)
# Format: postgresql://user:password@host:port/database
# Examples:
#   Local: postgresql://postgres:password@localhost:5432/arihant_db
#   Neon (cloud): postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/arihant_db

# ─── JWT AUTHENTICATION [REQUIRED] ─────────────────────────────────────────
# Secret key for signing JWT tokens (min 32 characters, use strong random string)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ─── SERVER CONFIGURATION ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend URL (for password reset links, CORS, redirects)
FRONTEND_URL=http://localhost:5173

# CORS: Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173

# ─── PAYMENT GATEWAY: RAZORPAY ─────────────────────────────────────────────
# Leave blank to disable payment features (webhooks will be skipped)
# Obtain from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── EMAIL SERVICE: SMTP ───────────────────────────────────────────────────
# Required for: password resets, order confirmations, B2B inquiries, newsletter
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your.email@gmail.com
#   SMTP_PASS=app_password (use App Password, not regular password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@arihant.com
SMTP_FROM_NAME=Arihant Stationery

# ─── GOOGLE OAUTH (Future Implementation) ──────────────────────────────────
# Optional: Social login integration
# Obtain from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── AWS S3 FILE UPLOADS (Future Implementation) ─────────────────────────
# Optional: Store product images, gallery, documents
# Obtain from: https://aws.amazon.com/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=arihant-uploads
AWS_S3_REGION=ap-south-1

# ─── LOGGING ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/combined.log
LOG_ERROR_FILE=logs/error.log

# ─── FEATURE FLAGS (for gradual rollout) ──────────────────────────────────
ENABLE_WISHLIST=true
ENABLE_REVIEWS=true
ENABLE_COUPONS=false
ENABLE_B2B=true
SMTP_URL=smtp://user:pass@smtp.example.com:587
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email_user
SMTP_PASS=your_email_password
MAILER_FROM=noreply@arihant.com

# ─── Stripe Secrets (Payments) ─────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ─── Sentry (Backend Error Tracking) ───────────────────────────
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxx.ingest.us.sentry.io/xxxxxx

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
